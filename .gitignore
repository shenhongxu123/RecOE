# Keep source, configuration, documentation, and license files trackable.
# Do not add blanket *.json, *.yaml, *.yml, *.csv, or LICENSES/ rules.

# Local documentation and verification artifacts.
/.githubignore
/docs/
/scripts/
/tests/

# Include only the four published checkpoint files.
!/src/snapshots/
/src/snapshots/*
!/src/snapshots/cifar10/
/src/snapshots/cifar10/*
!/src/snapshots/cifar10/cifar10_wrn_s1_recoe_tune_progressive_stiefel_epoch_9.pt
!/src/snapshots/cifar10/cifar10_wrn_s1_recoe_tune_progressive_stiefel_subspace_epoch_9.pt
!/src/snapshots/imagenet/
/src/snapshots/imagenet/*
!/src/snapshots/imagenet/net_epoch_4.pt
!/src/snapshots/imagenet/stiefel_epoch_4.pt
